<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:gravity="center_horizontal">
    <TextView android:id="@+id/tvUsuMan" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:textColor="#003399"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manipular Circuito (ESP32)" android:textSize="20sp" android:textStyle="bold" android:gravity="center"/>
    <TextView android:id="@+id/tvDist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- cm" android:textSize="40sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tvEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Esperando datos del sensor..."/>
    <TextView android:id="@+id/tvUltCmd" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Sin comandos aún" android:layout_marginBottom="16dp"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@+id/btnActivar" android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/circulo" android:text="LED ON" android:textColor="#000000"/>
        <Button android:id="@+id/btnDesactivar" android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/circulo" android:text="LED OFF" android:textColor="#000000" android:layout_marginStart="24dp"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <EditText android:id="@+id/etUmbral" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Umbral (cm)" android:inputType="number"/>
        <Button android:id="@+id/btnUmbral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fijar umbral" android:backgroundTint="#000000" android:textColor="#FFFFFF"/>
    </LinearLayout>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Volver" android:backgroundTint="#B00020" android:textColor="#FFFFFF" android:layout_marginTop="16dp"/>
</LinearLayout>